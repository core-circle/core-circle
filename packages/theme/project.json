{
  "name": "@core-circle/theme",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/theme",
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "dependsOn": ["^build"],
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "packages/theme/dist",
        "configFile": "packages/theme/vite.config.ts"
      }
    },
    "publish": {
      "command": "npm publish --access public",
      "options": {
        "cwd": "packages/theme"
      }
    }
  },
  "tags": ["package"]
}
