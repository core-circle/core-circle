{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "baseUrl": ".",
    "types": ["node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "emitDeclarationOnly": false,
    "declaration": true,
    "composite": true
  },
  "exclude": ["dist", "node_modules", "jest.config.ts", "jest.config.cts", "**/*.spec.ts", "**/*.test.ts"],
  "include": ["**/*.ts", "**/*.tsx"]
}
