{
  "name": "@core-circle/theme",
  "version": "0.0.8",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "tailwind-theme.css",
    "core-circle-themes",
    "fonts.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/core-circle/core-circle.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./preset": {
      "types": "./dist/preset.d.ts",
      "import": "./dist/preset.mjs",
      "require": "./dist/preset.cjs",
      "default": "./dist/preset.mjs"
    },
    "./theme-generator": {
      "types": "./dist/theme-generator.d.ts",
      "import": "./dist/theme-generator.mjs",
      "require": "./dist/theme-generator.cjs",
      "default": "./dist/theme-generator.mjs"
    },
    "./package.json": "./package.json",
    "./tailwind-theme.css": "./tailwind-theme.css",
    "./core-circle.theme.css": "./core-circle-themes/core-circle.theme.css",
    "./core-circle-themes/*": "./core-circle-themes/*",
    "./fonts.css": "./fonts.css"
  }
}
