{
  "compilerOptions": {
    "baseUrl": ".",
    "noPropertyAccessFromIndexSignature": true,
    "composite": false,
    "declaration": true,
    "emitDeclarationOnly": false,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@core-circle/source"],
    "paths": {
      "@core-circle/ui": ["packages/ui/src/index.ts"],
      "@core-circle/icons": ["packages/icons/index.ts"],
      "@core-circle/theme": ["packages/theme/index.ts"]
    }
  }
}
